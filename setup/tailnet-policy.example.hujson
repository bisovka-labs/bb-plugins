// Пример политики tailnet для закрытого доступа к bb (Tailscale admin → Access controls).
// Твои устройства без тегов видят всё; серверы с tag:server не видят Мак с bb совсем;
// Funnel (выставить порт в интернет) никому не разрешён. Сохрани старую политику перед заменой.
{
	"tagOwners": {
		// VPS и прочие серверы: им нельзя к bb и к твоим личным устройствам.
		"tag:server": ["autogroup:admin"],
	},

	"grants": [
		// Твои собственные устройства — полный доступ внутри tailnet.
		{
			"src": ["autogroup:member"],
			"dst": ["*"],
			"ip":  ["*"],
		},
		// Серверы ходят только друг к другу по SSH. Если серверу нужен порт на Маке
		// (например, локальная модель), добавь отдельный grant с этим портом и только им.
		{
			"src": ["tag:server"],
			"dst": ["tag:server"],
			"ip":  ["tcp:22"],
		},
	],

	"ssh": [
		{
			"src":    ["autogroup:member"],
			"dst":    ["autogroup:self"],
			"users":  ["autogroup:nonroot", "root"],
			"action": "check",
		},
	],

	// Блока nodeAttrs с атрибутом "funnel" здесь нет специально: без него ни один агент
	// на Маке не сможет выставить bb в интернет через `tailscale funnel`.

	// Проверки, которые админка прогонит при сохранении. Раскомментируй и подставь
	// tailnet-IP своего Мака (команда `tailscale ip -4`).
	// "hosts": { "my-mac": "<tailnet-IP Мака>" },
	// "tests": [
	// 	{ "src": "tag:server", "proto": "tcp", "deny": ["my-mac:17443", "my-mac:38886", "my-mac:22"] },
	// ],
}
